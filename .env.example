# Repository and data locations. Copy to .env for interactive shells; systemd
# reads the equivalent values from ~/.config/virtualv_llm/env.
VIRTUALV_LLM_ROOT=/path/to/virtualv_llm
VIRTUALV_DATA_ROOT=/path/to/data-volume
VIRTUALV_MODEL_ROOT=/path/to/data-volume/models/llm
VIRTUALV_REPORT_ROOT=/path/to/virtualv_llm/reports
VIRTUALV_LLAMA_SERVER=/path/to/llama-server
VIRTUALV_1CAT_ENV=/path/to/1cat-vllm-environment
VIRTUALV_1CAT_LOG_ROOT=/path/to/data-volume/logs/vllm-1cat
